generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RelationshipType {
  PARENT
  CHILD
  SPOUSE
}

model Person {
  id          String         @id @default(cuid())
  firstName   String
  lastName    String
  gender      String?
  birthYear   Int?
  deathYear   Int?
  birthPlace  String?
  biography   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  relationships Relationship[] @relation("FromPerson")
  relatedTo     Relationship[] @relation("ToPerson")

  @@index([lastName, firstName])
}

model Relationship {
  id        String           @id @default(cuid())
  type      RelationshipType
  fromId    String
  toId      String
  from      Person           @relation("FromPerson", fields: [fromId], references: [id], onDelete: Cascade)
  to        Person           @relation("ToPerson", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([type, fromId, toId])
  @@index([fromId])
  @@index([toId])
}
